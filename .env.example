# Copia este archivo a .env (raíz, para docker compose) y a backend/.env (para npm run dev).
# Nunca subas .env al repositorio.

# --- Base de datos ---
POSTGRES_PASSWORD=pulso_dev_password
DB_PORT=5434
DATABASE_URL=postgres://pulso:pulso_dev_password@localhost:5434/pulsolocal

# --- Seguridad ---
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN_HOURS=8

# --- Frontend ---
FRONTEND_ORIGIN=http://localhost:5180
WEB_PORT=8090

# --- IA ---
# auto: usa Claude si hay ANTHROPIC_API_KEY; si no, el analizador heurístico local.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
